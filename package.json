{
  "name": "ai-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:spec && npm run sync:if-needed && npm run gen:suggestions",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spec": "tsx scripts/validate-spec.ts --strict-tests && tsx scripts/validate-claude-md.ts",
    "sync:notion": "tsx --conditions=react-server scripts/sync-notion.ts",
    "sync:if-needed": "tsx --conditions=react-server scripts/sync-if-needed.ts",
    "sync:check": "tsx --conditions=react-server scripts/check-notion-freshness.ts",
    "gen:suggestions": "tsx --conditions=react-server scripts/generate-suggestions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:smoke": "tsx scripts/smoke-test-llm.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.143",
    "@ai-sdk/react": "^3.0.219",
    "@aws-sdk/client-bedrock-runtime": "^3.1102.0",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/client-s3vectors": "^3.1103.0",
    "@aws-sdk/client-ssm": "^3.1103.0",
    "@aws-sdk/credential-providers": "^3.1097.0",
    "@hookform/resolvers": "^5.4.0",
    "@notionhq/client": "^5.22.0",
    "@vercel/functions": "^3.7.6",
    "ai": "^6.0.175",
    "class-variance-authority": "^0.7.1",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.27",
    "lucide-react": "^0.577.0",
    "next": "^16.2",
    "next-themes": "^0.4.6",
    "notion-to-md": "^3.1.9",
    "radix-ui": "^1.6.1",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2",
    "eslint-config-prettier": "^9",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vitest": "^4.1.5"
  }
}

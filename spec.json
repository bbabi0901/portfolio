      ]
    },
    {
      "id": "Q-015",
      "category": "quality",
      "text": "어떻게 테스트하시나요?",
      "expectedSourceTitles": [
        "밈코인 소셜 플랫폼 어드민 페이지"
      ]
    },
    {
      "id": "Q-016",
      "category": "team",
      "text": "팀 온보딩이나 길드 활동 한 적 있어요?",
      "expectedSourceTitles": [
        "김윤수 이력서"
      ]
    },
    {
      "id": "Q-017",
      "category": "stack",
      "text": "자주 쓰는 기술 스택은요?",

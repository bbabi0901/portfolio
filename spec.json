        "하네스 엔지니어링 (Harness Engineering)"
      ]
    }
  ],
  "errorPolicies": [
    {
      "id": "ERR-01",
      "trigger": "client.offline",
      "userMessage": "인터넷 연결을 확인해 주세요.",
      "ui": "toast",
      "retry": "manual"
    },
    {
      "id": "ERR-02",
      "trigger": "chat.4xx",
      "userMessage": "요청을 처리할 수 없어요.",
      "ui": "toast",
      "highlight": "input"
    },
    {
      "id": "ERR-03",
      "trigger": "chat.401_403",
      "userMessage": "이 모델은 일시적으로 사용 불가능해요. 다른 모델로 시도해 보시겠어요?",
      "ui": "toast+fallbackButton",
      "fallback": "default-model",
      "alert": true
    },
    {
      "id": "ERR-04",
      "trigger": "chat.429",
      "userMessage": "잠시 후 다시 시도해 주세요.",
      "ui": "toast+countdown"
    },
    {
      "id": "ERR-05",
      "trigger": "chat.5xx",
      "userMessage": "일시적인 오류가 났어요. 다시 시도해 주세요.",
      "ui": "toast+retry",
      "alert": true
    },
    {
      "id": "ERR-06",
      "trigger": "chat.timeout",
      "userMessage": "응답이 늦어 중단했어요.",
      "ui": "toast"
    },
    {
      "id": "ERR-07",
      "trigger": "chat.emptyResponse",
      "userMessage": "답변을 만들지 못했어요. 다른 질문 부탁드려요."
    },
    {
      "id": "ERR-08",
      "trigger": "retrieval.emptyResults",
      "userMessage": "그 부분은 기록되어 있지 않습니다 — 다른 게 궁금하시면 알려주세요.",
      "ui": "inline-no-llm-call"
    },
    {
      "id": "ERR-09",
      "trigger": "feedback.notion-fail",
      "userMessage": "전송 실패, 잠시 후 다시 시도해 주세요.",
      "fallback": "github-issue|email-mailto",
      "alert": true
    },
    {
      "id": "ERR-10",
      "trigger": "spec.invalid",
      "userMessage": "사이트 설정 오류. 잠시 후 다시 시도해 주세요.",
      "behavior": "build-fail"
    },
    {
      "id": "ERR-11",
      "trigger": "portfolio.missing",
      "userMessage": "포트폴리오 데이터를 불러오지 못했어요. 잠시 후 새로고침해 주세요.",
      "alert": true
    },
    {
      "id": "ERR-12",
      "trigger": "localStorage.fail",
      "userMessage": null,
      "behavior": "memory-fallback"
    },
    {
      "id": "ERR-13",
      "trigger": "model.unknownId",
      "userMessage": null,
      "behavior": "downgrade-default",
      "header": "X-Model-Substitution"
    },
    {
      "id": "ERR-14",
      "trigger": "embedding.down",
      "userMessage": null,
      "behavior": "keyword-only",
      "header": "X-Retrieval-Mode"
    },
    {
      "id": "ERR-15",
      "trigger": "sync.partial",
      "userMessage": null,
      "behavior": "keep-last-success"
    },
    {
      "id": "ERR-16",
      "trigger": "tokens.dailyCap",
      "userMessage": "오늘은 너무 많은 분이 와주셨어요. 내일 다시 만나요!",
      "ui": "503-page"
    },
    {
      "id": "ERR-17",
      "trigger": "clipboard.fail",
      "userMessage": "복사할 수 없는 환경이에요."
    },
    {
      "id": "ERR-18",
      "trigger": "og.renderFail",
      "userMessage": null,
      "behavior": "static-fallback-png"
    },
    {
      "id": "ERR-19",
      "trigger": "font.loadFail",
      "userMessage": null,
      "behavior": "system-font-fallback"
    },
    {
      "id": "ERR-20",
      "trigger": "notion.privatePageOnSync",
      "userMessage": null,
      "behavior": "skip-page+log"
    },
    {
      "id": "ERR-21",
      "trigger": "contact.notion.5xx",
      "userMessage": "전송 실패. 직접 메일로 보내주세요.",
      "fallback": "resend|mailto",
      "alert": true
    },
    {
      "id": "ERR-22",
      "trigger": "contact.4xx",
      "userMessage": "입력 값을 확인해 주세요.",
      "ui": "field-inline-errors"
    },
    {
      "id": "ERR-23",
      "trigger": "contact.429",
      "userMessage": "잠시 후 다시 시도해 주세요.",
      "ui": "toast+countdown"
    },
    {
      "id": "ERR-24",
      "trigger": "mdx.buildFail",
      "userMessage": null,
      "behavior": "build-fail"
    },
    {
      "id": "ERR-25",
      "trigger": "sideSheet.runtimeError",
      "userMessage": null,
      "behavior": "fallback-route-home"
    },
    {
      "id": "ERR-26",
      "trigger": "resend.fail",
      "userMessage": null,
      "behavior": "silent"
    },
    {
      "id": "ERR-27",
      "trigger": "env.NOTION_CONTACT_DB_ID.missing",
      "userMessage": "연락 폼이 일시적으로 사용 불가능해요. 직접 메일 주세요.",
      "ui": "503+mailto",
      "alert": true
    }
  ],
  "edgeCasePolicies": [
    {
      "id": "EC-01",
      "scenario": "empty message submit",
      "behavior": "client.zod.reject + button.disabled"
    },
    {
      "id": "EC-02",
      "scenario": "message > 500 chars",
      "behavior": "trim+toast"
    },
    {
      "id": "EC-03",
      "scenario": "single short word query",
      "behavior": "keyword-only retrieval"
    },
    {
      "id": "EC-04",
      "scenario": "english query",
      "behavior": "english response, korean source links"
    },
    {
      "id": "EC-05",
      "scenario": "mixed ko/en query",
      "behavior": "korean response"
    },
    {
      "id": "EC-06",
      "scenario": "repeat same question",
      "behavior": "no cache, fresh response"
    },
    {
      "id": "EC-07",
      "scenario": "long conversation > 50 turns",
      "behavior": "trim oldest, keep system + last 20"
    },
    {
      "id": "EC-08",
      "scenario": "viewport rotate",
      "behavior": "stable layout"
    },
    {
      "id": "EC-09",
      "scenario": "iOS Safari IME composition",
      "behavior": "3-way check no-submit"
    },
    {
      "id": "EC-10",
      "scenario": "prefers-reduced-motion",
      "behavior": "no animations"
    },
    {
      "id": "EC-11",
      "scenario": "OS prefers-light",
      "behavior": "force dark"
    },
    {
      "id": "EC-12",
      "scenario": "page refresh",
      "behavior": "stateless, model selection persists"
    },
    {
      "id": "EC-13",
      "scenario": "image-only chunk",
      "behavior": "use alt or skip"
    },
    {
      "id": "EC-14",
      "scenario": "notion permission denied page",
      "behavior": "skip with warning"
    },
    {
      "id": "EC-15",
      "scenario": "first token > 5s",
      "behavior": "show 'preparing' helper"
    },
    {
      "id": "EC-16",
      "scenario": "submit during streaming",
      "behavior": "abort + new request"
    },
    {
      "id": "EC-17",
      "scenario": "carousel boundary",
      "behavior": "arrow disabled"
    },
    {
      "id": "EC-18",
      "scenario": "broken markdown response",
      "behavior": "render as-is"
    },
    {
      "id": "EC-19",
      "scenario": "mermaid in code block",
      "behavior": "render as code only"
    },
    {
      "id": "EC-20",
      "scenario": "duplicate downvote on same message",
      "behavior": "single submission"
    },
    {
      "id": "EC-21",
      "scenario": "user action during greeting sim",
      "behavior": "fast-forward+process"
    },
    {
      "id": "EC-22",
      "scenario": "refresh with greeted flag",
      "behavior": "static greeting"
    },
    {
      "id": "EC-23",
      "scenario": "user scrolled up + new message",
      "behavior": "no auto-scroll + jump button"
    },
    {
      "id": "EC-24",
      "scenario": "clipboard permission denied",
      "behavior": "execCommand fallback + toast"
    },
    {
      "id": "EC-25",
      "scenario": "source url private",
      "behavior": "disabled chip"
    },
    {

    {
      "id": "Q-006",
      "category": "architecture",
      "text": "대규모 프론트엔드 구조를 어떻게 설계했어요?",
      "expectedSourceTitles": [
        "밈코인 통합 소셜 플랫폼"
      ]
    },
    {
      "id": "Q-007",
      "category": "performance",
      "text": "빌드·번들 성능을 어떻게 개선했어요?",

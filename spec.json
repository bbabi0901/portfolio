{
  "$schema": "./spec.schema.json",
  "version": "0.7.9",
  "service": {
    "name": "ai-portfolio",
    "owner": "yoonsoo",
    "ownerEmail": "bbabi0901@gmail.com",
    "homepage": "https://yoonsoo.dev",
    "repo": "github:YoonsooKim9/portfolio",
    "timezone": "Asia/Seoul"
  },
  "greeting": {
    "message": "안녕하세요! 저는 프론트엔드 개발자 **김윤수**입니다.\n\n만나서 반가워요 — 제 커리어·프로젝트·기술에 대해 무엇이든 물어봐 주세요.\n\n어떤 게 궁금하신가요?",
    "typingDelayMs": 600,
    "wordIntervalMs": [
      30,
      50
    ],
    "rememberDays": 30
  },
  "models": [
    {
      "id": "nova-lite",
      "provider": "amazon",
      "default": true,
      "maxOutputTokens": 1024,
      "temperature": 0.3,
      "topP": 0.9
    },
    {
      "id": "nova-micro",
      "provider": "amazon",
      "default": false,
      "maxOutputTokens": 1024,
      "temperature": 0.3,
      "topP": 0.9
    },
    {
      "id": "claude-haiku",
      "provider": "anthropic",
      "default": false,
      "maxOutputTokens": 1024,
      "temperature": 0.3,
      "topP": 0.9
    }
  ],
  "rateLimits": {
    "chatPerMinute": 10,
    "chatPerDay": 100,
    "feedbackPerMinute": 5,
    "feedbackPerDay": 30,
    "contactPerMinute": 3,
    "contactPerDay": 10,
    "maxTokensPerDayDefault": 200000,
    "maxMessageLength": 500
  },
  "retrieval": {
    "embeddingModel": "text-embedding-3-small",
    "embeddingDimensions": 1536,
    "topK": 8,
    "maxContextTokens": 6000,
    "weights": {
      "keyword": 0.4,
      "vector": 0.6
    },
    "minVectorScore": 0.3,
    "minQueryLengthForEmbedding": 5
  },
  "pages": [
    {
      "route": "/",
      "name": "landing",
      "type": "ssg",
      "title": "김윤수 — AI Portfolio",
      "description": "프론트엔드 개발자 김윤수의 대화형 포트폴리오. 무엇이든 물어보세요.",
      "ogImage": "/opengraph-image"
    },
    {
      "route": "/chat",
      "name": "chat",
      "type": "client",
      "title": "대화",
      "description": "AI에게 물어보는 김윤수의 커리어와 프로젝트.",
      "ogImage": "/opengraph-image"
    },
    {
      "route": "/about",
      "name": "about",
      "type": "ssg",
      "title": "자기소개",
      "description": "프론트엔드 개발자 김윤수의 가치관, 성격, 취미.",
      "ogImage": "/opengraph-image"
    },
    {
      "route": "/experience",
      "name": "experience",
      "type": "ssg",
      "title": "커리어",
      "description": "김윤수의 커리어·프로젝트 타임라인 + 학력·자격증·보유 스킬.",
      "ogImage": "/opengraph-image"
    },
    {
      "route": "/contact",
      "name": "contact",
      "type": "client",
      "title": "연락하기",
      "description": "프로젝트 협업 또는 채용 관련 문의를 남겨주세요.",
      "ogImage": "/opengraph-image"
    },
    {
      "route": "/not-found",
      "name": "not-found",
      "type": "static",
      "title": "페이지를 찾을 수 없어요",
      "description": "요청하신 페이지가 없습니다.",
      "robots": "noindex, nofollow"
    }
  ],
  "forms": [
    {
      "id": "contact",
      "fields": [
        {
          "name": "name",
          "type": "text",
          "required": true,
          "minLength": 1,
          "maxLength": 40,
          "trim": true,
          "autocomplete": "given-name"
        },
        {
          "name": "email",
          "type": "email",
          "required": true,
          "autocomplete": "email"
        },
        {
          "name": "message",
          "type": "textarea",
          "required": true,
          "minLength": 10,
          "maxLength": 2000
        },
        {
          "name": "website",
          "type": "honeypot",
          "required": false,
          "mustBeEmpty": true
        }
      ],
      "minSubmitDelayMs": 1500,
      "destination": {
        "primary": "notion",
        "fallback": [
          "resend",
          "mailto"
        ]
      }
    }
  ],
  "responsive": {
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280,
      "2xl": 1536
    },
    "maxW": {
      "/": {
        "sm": "full",
        "md": "max-w-3xl",
        "lg": "max-w-3xl"
      },
      "/about": {
        "sm": "full",
        "md": "max-w-2xl",
        "lg": "max-w-2xl"
      },
      "/experience": {
        "sm": "full",
        "md": "max-w-3xl",
        "lg": "max-w-4xl"
      },
      "/contact": {
        "sm": "full",
        "md": "max-w-2xl",
        "lg": "max-w-2xl"
      }
    },
    "headerHeight": {
      "sm": 56,
      "md": 64
    },
    "sideSheetWidth": {
      "sm": "100vw",
      "md": "320px"
    },
    "carouselSlides": {
      "sm": 1.2,
      "md": 2,
      "lg": 3
    },
    "messageMaxW": {
      "sm": "85%",
      "md": "75%"
    },
    "fontBase": {
      "sm": 14,
      "md": 14.5,
      "lg": 15
    },
    "deviceMatrix": [
      {
        "name": "iPhone SE",
        "width": 375,
        "height": 667
      },
      {
        "name": "iPhone 14 Pro",
        "width": 393,
        "height": 852
      },
      {
        "name": "Galaxy S23",
        "width": 360,
        "height": 780
      },
      {
        "name": "iPad Mini",
        "width": 768,
        "height": 1024
      },
      {
        "name": "MacBook 13",
        "width": 1280,
        "height": 800
      },
      {
        "name": "Desktop 4K",
        "width": 2560,
        "height": 1440
      }
    ]
  },
  "suggestedQuestions": [
    {
      "id": "Q-001",
      "category": "intro",
      "text": "김윤수 어떤 개발자예요?",
      "expectedSourceTitles": [

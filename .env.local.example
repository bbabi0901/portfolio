# ===== LLM 모델 키 =====
# OPENAI_API_KEY는 채팅 + 임베딩 둘 다 필요. 누락 시 채팅 503, 빌드 실패.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY 누락 시 Claude 모델 비활성, GPT/Gemini만 노출.
ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY 누락 시 Gemini 비활성.
GOOGLE_GENERATIVE_AI_API_KEY=

# ===== Notion =====
# 봇 통합 토큰. 누락 시 빌드 실패. (https://www.notion.so/my-integrations)
NOTION_TOKEN=
# 프로젝트 DB의 ID (32자, 하이픈 무관). 누락 시 빌드 실패.
NOTION_PROJECTS_DB_ID=
# 자기소개/이력서/MBTI/취미 페이지 ID들. 콤마로 구분. 권한 없는 페이지는 빌드시 스킵.
NOTION_PROFILE_PAGE_IDS=
# Q&A 피드백 DB ID. 누락 시 피드백 UI 비활성.
NOTION_FEEDBACK_DB_ID=
# Contact DB ID. 누락 시 Contact 폼 503 + mailto 폴백.
NOTION_CONTACT_DB_ID=

# ===== 알림 (선택) =====
# Resend (https://resend.com). Contact 알림 이메일 발송에 사용. 없으면 silent.
RESEND_API_KEY=
# 본인 이메일(알림 받을 곳).
RESEND_TO_EMAIL=bbabi0901@gmail.com

# ===== 운영 가드 =====
# 일별 토큰 합산 상한. 초과 시 503.
MAX_TOKENS_PER_DAY=200000
# dev에서 rate limit 무시하려면 1.
RATE_LIMIT_BYPASS=

# ===== Upstash Redis (선택, rate limit 영속화) =====
# 미설정 시 메모리 LRU 폴백.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== 빌드 옵션 =====
# 1이면 빌드시 sync:notion 건너뜀 (CI 캐시 활용).
SKIP_NOTION_SYNC=
# E2E/단위 테스트에서 LLM 호출 mock 모드.
MOCK_LLM=
# E2E/단위 테스트에서 Notion 호출 mock 모드.
MOCK_NOTION=

# ===== Cloudflare Turnstile (선택, P2) =====
# 미설정 시 봇 보호는 honeypot + 시간 임계 + rate limit만.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
